
ToolCard {
  width: 100%;
  height: 20;
  padding: 1 2;
  content-align: center middle;
}

.box {
    width: 1fr;
    height: 100%;
    border: panel $accent;
    content-align: center middle;
}

.desc-box {
  width: 1fr;
  height: 100%;
  content-align: center middle;
  border: vkey $accent;
}

Grid {
    grid-size: 2 1;
    grid-rows: 2fr;
}
